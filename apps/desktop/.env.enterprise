# ============================================
# 企业版配置文件
# Enterprise Edition Configuration
# ============================================
#
# 使用方法 / Usage:
# 1. 复制此文件为 .env
#    Copy this file as .env
#
# 2. 或者在构建时指定:
#    Or specify during build:
#    cp .env.enterprise .env && pnpm run build:electron
#
# ============================================

# API 配置 - 根据实际企业部署调整
# API Configuration - Adjust according to your enterprise deployment
VITE_WEB_URL=https://app.folo.is
VITE_API_URL=https://api.follow.is
# 或使用企业内部 API / Or use internal enterprise API
# VITE_API_URL=https://your-company-api.example.com

VITE_IMGPROXY_URL=
VITE_SENTRY_DSN=
VITE_BUILD_TYPE=production
VITE_INBOXES_EMAIL=@follow.re
VITE_OPENPANEL_CLIENT_ID=
VITE_OPENPANEL_API_URL=

VITE_EDITOR=cursor

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# ============================================
# 🏢 企业版核心配置
# 🏢 Enterprise Mode Core Configuration
# ============================================
# 启用企业版模式: 强制所有用户拥有 Pro 角色权限
# Enable enterprise mode: Force all users to have Pro role permissions
VITE_ENTERPRISE_MODE=true

# ============================================
# 企业版模式效果 / Enterprise Mode Effects:
# ============================================
# ✅ 所有用户自动获得 Pro 角色
#    All users automatically get Pro role
#
# ✅ 不受后端返回的角色限制
#    Not limited by backend role response
#
# ✅ 订阅限制设为 999999 (无限制)
#    Subscription limits set to 999999 (unlimited)
#    - rsshubSubscriptionLimit: 999999
#    - feedSubscriptionLimit: 999999
#
# ✅ 所有 Pro 功能自动启用:
#    All Pro features automatically enabled:
#    - 安全图片代理 (Secure Image Proxy)
#    - AI 翻译 (AI Translation)
#    - AI 摘要 (AI Summary)
#    - 自定义 Feed (Custom Feed)
#    - 无订阅数量限制 (Unlimited subscriptions)
#
# ============================================
